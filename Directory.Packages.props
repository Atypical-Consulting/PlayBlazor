<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Runtime Dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
  </ItemGroup>
  <!-- Development Tools -->
  <ItemGroup>
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>
  <!-- Demo & Test Dependencies -->
  <!-- MudBlazor, Fluent UI and DaisyBlazor are NOT dependencies of the PlayBlazor package: they are
       the libraries the demo and the render-sweep tests point PlayBlazor AT. Any Blazor library would do. -->
  <ItemGroup>
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <!-- Components only: DaisyBlazor.Charts is a separate assembly the demo does not explore. -->
    <PackageVersion Include="DaisyBlazor.Components" Version="0.8.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="bunit" Version="2.12.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="nunit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
