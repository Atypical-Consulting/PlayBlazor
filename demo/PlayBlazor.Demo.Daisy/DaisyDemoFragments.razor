@namespace PlayBlazor.Demo.Daisy
@using DaisyBlazor.Data
@using DaisyBlazor.Validation
@* Static example fragments used as slot presets, each mirrored verbatim by a string in
   DaisyDemoFragmentSources.cs. Any Tailwind class written here is compiled into app.css, since the
   CLI scans this project's .razor and .cs files; runtime-composed classes come from DaisyBlazor's
   safelist instead. Fragments land with the batches that curate their components.

   The In* members are scaffolds: they take the played specimen and place it inside the parent it
   needs, beside a sibling so the child shows as one of several (tab strips, timelines and steps
   draw their connectors and selection between siblings). *@
@code {
    // --- Slot fragments ---------------------------------------------------------------------

    public static RenderFragment TabPanel => @<p>Ada Lovelace wrote the first published algorithm.</p>;

    public static RenderFragment CarouselSlide => @<div class="bg-primary text-primary-content rounded-box flex h-40 w-64 items-center justify-center text-xl">Slide 1</div>;

    public static RenderFragment GridCell => @<div class="bg-base-200 rounded-box p-4">Grid cell</div>;

    public static RenderFragment RowCells => @<text>
        <Td>Ada Lovelace</Td>
        <Td>Analyst</Td>
    </text>;

    public static RenderFragment CardHeaderText => @<text>
        <h2 class="card-title">Ada Lovelace</h2>
        <p class="text-sm opacity-70">Analyst</p>
    </text>;

    public static RenderFragment CardBodyText => @<text>
        <h2 class="card-title">Analytical Engine</h2>
        <p>The first design for a general-purpose computer.</p>
    </text>;

    public static RenderFragment CardButtons => @<Button Variant="Variant.Filled" Color="Color.Primary">Read more</Button>;

    public static RenderFragment ServerValidatedField => @<TextField Label="Email" FieldName="Email" Value="@("ada@example.com")" />;

    public static RenderFragment FormFields => @<text>
        <TextField Label="Name" Value="@("Ada Lovelace")" Required="true" />
        <TextField Label="Email" InputType="InputType.Email" Placeholder="ada@example.com" />
        <Button Color="Color.Primary" Variant="Variant.Filled">Submit</Button>
    </text>;

    public static RenderFragment EmailInput => @<input type="email" class="input validator" placeholder="ada@example.com" required />;

    public static RenderFragment DialogBody => @<p>12 services restart in all 3 regions on Friday at midnight.</p>;

    public static RenderFragment DialogButtons => @<text>
        <Button Variant="Variant.Text">Later</Button>
        <Button Color="Color.Primary" Variant="Variant.Filled">Deploy</Button>
    </text>;

    public static RenderFragment ModalBody => @<p>We will email Dana an invitation to join the workspace.</p>;

    public static RenderFragment ModalButtons => @<Button Color="Color.Primary" Variant="Variant.Filled">Send invite</Button>;

    public static RenderFragment DrawerSide => @<div class="bg-base-200 min-h-full w-40 p-2">
        <ItemList>
            <ListItem Icon="home" Text="Home" />
            <ListItem Icon="folder" Text="Projects" />
            <ListItem Icon="settings" Text="Settings" />
        </ItemList>
    </div>;

    public static RenderFragment DrawerMain => @<p class="p-4">Main content sits beside the open panel.</p>;

    public static RenderFragment GroupButtons => @<text>
        <Button>Day</Button>
        <Button>Week</Button>
        <Button>Month</Button>
    </text>;

    public static RenderFragment FabActions => @<text>
        <FabAction Icon="@Icons.Material.Filled.Edit" Tooltip="Edit" />
        <FabAction Icon="@Icons.Material.Filled.Share" Tooltip="Share" />
    </text>;

    public static RenderFragment SwapOn => @<Icon Name="@Icons.Material.Filled.DarkMode" Size="Size.Large" />;

    public static RenderFragment SwapOff => @<Icon Name="@Icons.Material.Filled.LightMode" Size="Size.Large" />;

    public static RenderFragment SelectOptions => @<text>
        <SelectItem Value="@("apple")">Apple</SelectItem>
        <SelectItem Value="@("banana")">Banana</SelectItem>
        <SelectItem Value="@("cherry")">Cherry</SelectItem>
    </text>;

    public static RenderFragment RadioOptions => @<text>
        <Radio Value="@("apple")" Label="Apple" />
        <Radio Value="@("banana")" Label="Banana" />
        <Radio Value="@("cherry")" Label="Cherry" />
    </text>;

    public static RenderFragment ToggleItems => @<text>
        <ToggleItem Value="@("list")" Text="List" Icon="@Icons.Material.Filled.ViewList" />
        <ToggleItem Value="@("grid")" Text="Grid" Icon="@Icons.Material.Filled.GridView" />
        <ToggleItem Value="@("table")" Text="Table" Icon="@Icons.Material.Filled.TableRows" />
    </text>;

    // daisyUI floats the span once the input is focused or filled; the placeholder fills the empty box.
    public static RenderFragment FloatingInput => @<input type="email" class="input" placeholder="ada@example.com" />;

    // --- Scaffolds --------------------------------------------------------------------------

    // The specimen initialises (so registers) after the sibling wherever it sits in the markup, and
    // again after a reset re-keys it: it is always tab 1, which ActiveIndex=1 selects.
    public static RenderFragment InTabs(RenderFragment specimen) =>
        @<Tabs ActiveIndex="1">
            <Tab Title="Overview">Born in London in 1815.</Tab>
            @specimen
        </Tabs>;

    public static RenderFragment InSelect(RenderFragment specimen) =>
        @<Select T="string" Label="Fruit" Value="@("banana")">
            <SelectItem Value="@("apple")">Apple</SelectItem>
            @specimen
        </Select>;

    public static RenderFragment InTable(RenderFragment specimen) =>
        @<Table T="Person" Items="DaisyPlaygroundConfig.SampleRows" RowsPerPage="2">
            <HeaderContent>
                <Th>Name</Th>
                <Th>Role</Th>
            </HeaderContent>
            <RowTemplate>
                <Td>@context.Name</Td>
                <Td>@context.Role</Td>
            </RowTemplate>
            <PagerContent>
                @specimen
            </PagerContent>
        </Table>;

    public static RenderFragment InDataGridPager(RenderFragment specimen) =>
        @<DataGrid T="Person" Items="DaisyPlaygroundConfig.SampleRows" RowsPerPage="2" PageSizeOptions="PageSizes">
            <Columns>
                <PropertyColumn T="Person" TProperty="string" Property="p => p.Name" />
                <PropertyColumn T="Person" TProperty="string" Property="p => p.Role" />
            </Columns>
            <PagerContent>
                @specimen
            </PagerContent>
        </DataGrid>;

    public static RenderFragment InDataGrid(RenderFragment specimen) =>
        @<DataGrid T="Person" Items="DaisyPlaygroundConfig.SampleRows">
            <Columns>
                @specimen
                <PropertyColumn T="Person" TProperty="int" Property="p => p.Age" Title="Age" />
            </Columns>
        </DataGrid>;

    public static RenderFragment InRadioGroup(RenderFragment specimen) =>
        @<RadioGroup T="string" Label="Fruit" Value="@("apple")">
            @specimen
            <Radio Value="@("banana")" Label="Banana" />
        </RadioGroup>;

    public static RenderFragment InToggleGroup(RenderFragment specimen) =>
        @<ToggleGroup T="string" Value="@("grid")">
            @specimen
            <ToggleItem Value="@("list")" Text="List" />
        </ToggleGroup>;

    // Menu renders its items only while open, and an open Menu lays a `fixed inset-0` backdrop over
    // the whole viewport that swallows the next click anywhere (closing the menu, which then stays
    // closed). The transform makes the Menu root the containing block of that backdrop, so it only
    // covers the activator. The h-48 box leaves room for the absolutely positioned list.
    public static RenderFragment InMenu(RenderFragment specimen) =>
        @<div class="h-48">
            <Menu Label="Actions" Open="true" Style="@MenuContainment">
                @specimen
                <MenuItem Icon="share">Share</MenuItem>
            </Menu>
        </div>;

    public static RenderFragment InExpansionPanels(RenderFragment specimen) =>
        @<ExpansionPanels>
            @specimen
            <ExpansionPanel Text="Returns">Free returns within 30 days.</ExpansionPanel>
        </ExpansionPanels>;

    public static RenderFragment InTimeline(RenderFragment specimen) =>
        @<Timeline>
            @specimen
            <TimelineItem>1843: Notes on the Analytical Engine</TimelineItem>
        </Timeline>;

    public static RenderFragment InCarousel(RenderFragment specimen) =>
        @<Carousel Class="rounded-box gap-4">
            @specimen
            <CarouselItem>
                <div class="bg-secondary text-secondary-content rounded-box flex h-40 w-64 items-center justify-center text-xl">Slide 2</div>
            </CarouselItem>
        </Carousel>;

    // Fixed defaults to true, which pins the dock to the bottom of the viewport, over the explorer.
    public static RenderFragment InDock(RenderFragment specimen) =>
        @<Dock Fixed="false">
            @specimen
            <DockItem Icon="settings" Label="Settings" />
        </Dock>;

    // daisyUI's .fab is position:fixed (bottom-right of the viewport). Fixed="false" swaps it for
    // `absolute`, anchored to this relative box, which is tall enough for the actions to unfold;
    // `isolate` keeps the .fab's z-index:999 from rising above the explorer's own overlays.
    public static RenderFragment InFab(RenderFragment specimen) =>
        @<div class="relative isolate h-64">
            <Fab Fixed="false" AriaLabel="Actions">
                @specimen
                <FabAction Icon="share" Tooltip="Share" />
            </Fab>
        </div>;

    // The Fab itself is the specimen here (FabAction's InFab holds a whole Fab). The preset's
    // Fixed="false" anchors it to this relative box; the transform also makes the box the
    // containing block of a position:fixed .fab, so flipping Fixed back on keeps it in the stage.
    public static RenderFragment InFabFrame(RenderFragment specimen) =>
        @<div class="relative isolate h-64" style="@MenuContainment">
            @specimen
        </div>;

    public static RenderFragment InSteps(RenderFragment specimen) =>
        @<Steps>
            @specimen
            <Step>Choose plan</Step>
            <Step>Purchase</Step>
        </Steps>;

    public static RenderFragment InItemList(RenderFragment specimen) =>
        @<ItemList>
            @specimen
            <ListItem Icon="send" Text="Sent" />
        </ItemList>;

    public static RenderFragment InList(RenderFragment specimen) =>
        @<List>
            @specimen
            <ListRow Icon="person" Title="Grace Hopper" Subtitle="Rear Admiral" />
        </List>;

    public static RenderFragment InGrid(RenderFragment specimen) =>
        @<Grid Spacing="4">
            @specimen
            <Item xs="6"><div class="bg-base-200 rounded-box p-4">Sibling</div></Item>
        </Grid>;

    public static RenderFragment InTbody(RenderFragment specimen) =>
        @<SimpleTable>
            <thead>
                <Tr><Th>Name</Th><Th>Role</Th></Tr>
            </thead>
            <tbody>
                @specimen
                <Tr><Td>Grace Hopper</Td><Td>Rear Admiral</Td></Tr>
            </tbody>
        </SimpleTable>;

    public static RenderFragment InBodyRow(RenderFragment specimen) =>
        @<SimpleTable>
            <thead>
                <Tr><Th>Name</Th><Th>Role</Th></Tr>
            </thead>
            <tbody>
                <Tr>
                    @specimen
                    <Td>Analyst</Td>
                </Tr>
            </tbody>
        </SimpleTable>;

    public static RenderFragment InHeaderRow(RenderFragment specimen) =>
        @<SimpleTable>
            <thead>
                <Tr>
                    @specimen
                    <Th>Role</Th>
                </Tr>
            </thead>
            <tbody>
                <Tr><Td>Ada Lovelace</Td><Td>Analyst</Td></Tr>
            </tbody>
        </SimpleTable>;

    public static RenderFragment InCardTop(RenderFragment specimen) =>
        @<Card Class="w-80">
            @specimen
            <CardContent>Wrote the first published algorithm.</CardContent>
        </Card>;

    public static RenderFragment InCard(RenderFragment specimen) =>
        @<Card Class="w-80">
            @specimen
        </Card>;

    public static RenderFragment InCardBottom(RenderFragment specimen) =>
        @<Card Class="w-80">
            <CardContent>Wrote the first published algorithm.</CardContent>
            @specimen
        </Card>;

    public static RenderFragment InStats(RenderFragment specimen) =>
        @<Stats Shadow="true">
            @specimen
            <Stat Title="Users" Value="4,200" Desc="↗︎ 400 (22%)" />
        </Stats>;

    public static RenderFragment InFooter(RenderFragment specimen) =>
        @<Footer Class="bg-base-200 text-base-content">
            <nav>
                @specimen
                <a class="link link-hover">Branding</a>
                <a class="link link-hover">Design</a>
            </nav>
        </Footer>;

    // FieldError reads the cascading ServerValidationState and renders nothing without one.
    public static RenderFragment InServerValidation(RenderFragment specimen) =>
        @<ServerValidation State="DaisyPlaygroundConfig.SampleValidation">
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Email</legend>
                <input type="email" class="input" value="ada@example.com" />
                @specimen
            </fieldset>
        </ServerValidation>;

    // daisyUI reveals .validator-hint only as a SIBLING of an invalid .validator. aria-invalid
    // makes the input invalid without the user touching it (:user-invalid needs an interaction).
    public static RenderFragment AfterInvalidInput(RenderFragment specimen) =>
        @<Validator>
            <input type="email" class="input validator" value="ada.example.com" aria-invalid="true" />
            @specimen
        </Validator>;

    // A static stand-in for the box DialogProvider renders. NOT .modal-box: daisyUI gives it
    // opacity:0 and only fades it in under an open .modal, so outside one it is invisible.
    public static RenderFragment InDialogBox(RenderFragment specimen) =>
        @<div class="rounded-box bg-base-100 max-w-lg p-6 shadow-xl ring-1 ring-base-300">
            @specimen
        </div>;

    public static RenderFragment WithModalNote(RenderFragment specimen) =>
        @<div>
            <p class="text-sm opacity-70">Shown while Open is true (bind it with @@bind-Open). It opens as a native modal over the whole page: Escape, the backdrop or the close button dismiss it.</p>
            @specimen
        </div>;

    // daisyUI's .drawer-side is 100dvh tall: the fixed-height, clipping box keeps the drawer
    // (given Class="h-full") to a bench-sized panel, as DaisyBlazor's own drawer examples do.
    public static RenderFragment InDrawerFrame(RenderFragment specimen) =>
        @<div class="rounded-box border-2 border-base-300 h-64 overflow-hidden">
            @specimen
        </div>;

    private const string MenuContainment = "transform: translateZ(0)";

    private static readonly int[] PageSizes = [2, 5, 10];
}
