    // daisyUI's .fab is position:fixed (bottom-right of the viewport). Fixed="false" swaps it for
    // `absolute`, anchored to this relative box, which is tall enough for the actions to unfold;
    // `isolate` keeps the .fab's z-index:999 from rising above the explorer's own overlays.
    public static RenderFragment InFab(RenderFragment specimen) =>
        @<div class="relative isolate h-64">
            <Fab Fixed="false" AriaLabel="Actions">
                @specimen
                <FabAction Icon="share" Tooltip="Share" />
            </Fab>
        </div>;

    // The Fab itself is the specimen here (FabAction's InFab holds a whole Fab). The preset's
    // Fixed="false" anchors it to this relative box; the transform also makes the box the
    // containing block of a position:fixed .fab, so flipping Fixed back on keeps it in the stage.
    public static RenderFragment InFabFrame(RenderFragment specimen) =>
        @<div class="relative isolate h-64" style="@MenuContainment">
            @specimen
        </div>;

