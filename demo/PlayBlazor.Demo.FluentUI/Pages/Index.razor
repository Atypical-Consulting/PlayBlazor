@page "/"
<DemoLanding Assembly="typeof(FluentButton).Assembly"
             LibraryName="@LibraryName"
             DocsUrl="@DocsUrl"
             Current="fluent">
    <Flagships>
        @* Fragment links stay base-relative too: "#id" resolves against <base href>, which is this page. *@
        <nav class="fx-benches" aria-label="On this page">
            <span class="fx-benches-label">On this page: three hand-tuned playgrounds, then every component</span>
            <a href="#bench-button">FluentButton</a>
            <a href="#bench-grid">FluentDataGrid</a>
            <a href="#bench-column">PropertyColumn</a>
            <a href="#catalog">All components</a>
            <a class="fx-docs" href="@DocsUrl" target="_blank" rel="noopener">Library docs &#8599;</a>
        </nav>

        <section class="demo-section fx-bench" id="bench-button">
            <h2 class="demo-tag">FluentButton</h2>
            <p class="demo-note">Opens on Fluent's Primary appearance. Pick an example, flip a parameter, and the snippet below follows; Reset all brings it back.</p>
            <PlaygroundView Component="typeof(FluentButton)" />
        </section>

        <section class="demo-section fx-bench fx-wide" id="bench-grid">
            <h2 class="demo-tag">FluentDataGrid&lt;Person&gt;</h2>
            <p class="demo-note">The demo supplies three sample rows and their columns. Striped, resizable, auto-fit and the rest are yours to flip.</p>
            <PlaygroundView Component="typeof(FluentDataGrid<Person>)" />
        </section>

        <section class="demo-section fx-bench fx-wide" id="bench-column">
            <h2 class="demo-tag">PropertyColumn&lt;Person, string&gt;</h2>
            <p class="demo-note">A column cannot render on its own, so the demo places the column you are editing inside a real FluentDataGrid.</p>
            <PlaygroundView Component="typeof(PropertyColumn<Person, string>)" />
        </section>

    </Flagships>
</DemoLanding>

@code {
    private const string LibraryName = "Fluent UI Blazor";
    private const string DocsUrl = "https://www.fluentui-blazor.net/";
}
