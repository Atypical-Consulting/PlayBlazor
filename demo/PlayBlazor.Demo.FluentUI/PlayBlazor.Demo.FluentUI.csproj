<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The showcased library is a release candidate; NU5104 would otherwise fail the build. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <!--
    PlayBlazor discovers components by reflection, and the IL trimmer only keeps what is
    statically referenced. Rooting the explored assembly keeps its constructors and
    [Parameter] properties whole; the framework is still trimmed. See CLAUDE.md.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.FluentUI.AspNetCore.Components" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
  </ItemGroup>

  <!-- wwwroot/index.html carries Fluent 5.0.1's dark-theme tokens and bench row positions,
       captured by hand: say so the moment the package moves. -->
  <Target Name="WarnFluentThemeSnapshot" BeforeTargets="Build">
    <Warning Condition="'%(PackageVersion.Identity)' == 'Microsoft.FluentUI.AspNetCore.Components' and '%(PackageVersion.Version)' != '5.0.1'"
             Text="Fluent UI is now %(PackageVersion.Version): regenerate the dark-theme tokens and re-check the hidden bench rows in wwwroot/index.html (captured for 5.0.1)." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlayBlazor\PlayBlazor.csproj" />
    <ProjectReference Include="..\PlayBlazor.Demo.Shared\PlayBlazor.Demo.Shared.csproj" />
  </ItemGroup>

</Project>
