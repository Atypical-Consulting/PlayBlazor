<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    PlayBlazor discovers components by reflection, and the IL trimmer only keeps what is
    statically referenced. A published trimmed build therefore strips the parameterless
    constructors and the [Parameter] properties of every component the demo does not spell out in
    markup: the bench then reports "could not be instantiated" and shows the four base parameters
    alone. Rooting the explored assembly keeps it whole; the framework is still trimmed.
    Any host pointing PlayBlazor at a library needs this, or PublishTrimmed=false.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- The showcased library: the demo points PlayBlazor at MudBlazor's component set. -->
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlayBlazor\PlayBlazor.csproj" />
  </ItemGroup>

</Project>
