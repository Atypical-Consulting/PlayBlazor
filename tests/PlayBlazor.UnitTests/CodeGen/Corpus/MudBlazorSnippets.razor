@code {
    private readonly IEnumerable<Person> _people = [];
    private readonly IReadOnlyList<BreadcrumbItem> _items = [];
    private readonly string[] _chartLabels = ["Jan", "Feb", "Mar", "Apr", "May"];
    private readonly List<ChartSeries<int>> _chartSeries = [];
    private readonly Expression<Func<Person, string>> _property = p => p.Name;
    private readonly Func<string, CancellationToken, Task<IEnumerable<string>>> _searchFunc =
        (_, _) => Task.FromResult<IEnumerable<string>>([]);
    private readonly RenderFragment _content = @<text>Content</text>;
}
