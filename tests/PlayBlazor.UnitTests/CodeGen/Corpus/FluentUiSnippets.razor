@code {
    private readonly IQueryable<Person> _people = Array.Empty<Person>().AsQueryable();
    private readonly Person _item = new("Ada Lovelace", "Analyst", 36);
    private readonly Func<Person, bool> _isSelected = _ => false;
    private readonly Expression<Func<Person, string>> _property = p => p.Name;
    private readonly string[] _colors = ["Red", "Green", "Blue"];
    private readonly string[] _tasks = ["Design", "Build", "Ship"];
    private readonly PaginationState _paginationState = new();
    private readonly object _model = new();
    private readonly FieldIdentifier? _field = null;
    @* CoreIcons is internal to the library, so a consumer cannot name it: the showcase's own
       hand-written catalogue is what a host would reach for, and is what the demo uses. *@
    private static readonly Icon HomeIcon = FluentIconCatalogue.All["Circle"];
    private static readonly Icon SearchIcon = FluentIconCatalogue.All["Search"];
    private static readonly Icon SettingsIcon = FluentIconCatalogue.All["Settings"];
}
