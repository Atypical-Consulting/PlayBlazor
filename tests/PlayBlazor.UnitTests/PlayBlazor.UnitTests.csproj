<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <IsPackable>false</IsPackable>
    <!-- This project references two Blazor WebAssembly demo apps purely for reflection (their
         compiled assembly and Configure method) — never their wwwroot. Left enabled, the static
         web assets pipeline tries to bundle both apps' _framework runtime files into one output
         and fails with "Conflicting assets with the same target path" the moment a second
         WebAssembly app is referenced alongside the first. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- CodeGen/Corpus/*.razor compiles every snippet the showcases can generate, so that markup
         which does not build breaks the build (see SnippetCorpusTests). Two of those snippets
         leave an [EditorRequired] parameter unset, and RZ2012 would be an error here under
         TreatWarningsAsErrors: FluentSortableList.ItemTemplate and TemplateColumn.ChildContent are
         RenderFragment<T>, which ParameterDictionaryBuilder.BuildSlot cannot fill, and
         FluentAppBarItem.IconRest is an Icon, which FormatValue deliberately omits rather than
         print a type name that does not compile. Both gaps are recorded beside the components in
         FluentPlaygroundConfig; neither is a syntax error, so suppressing RZ2012 costs this corpus
         nothing it was built to catch. -->
    <NoWarn>$(NoWarn);RZ2012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="nunit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!-- The library under test for the discovery and render-sweep suites. PlayBlazor itself has
         no MudBlazor dependency; MudBlazor is simply the biggest component set to point it at. -->
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlayBlazor\PlayBlazor.csproj" />
    <ProjectReference Include="..\..\demo\PlayBlazor.Demo.MudBlazor\PlayBlazor.Demo.MudBlazor.csproj" />
    <ProjectReference Include="..\..\demo\PlayBlazor.Demo.FluentUI\PlayBlazor.Demo.FluentUI.csproj" />
    <ProjectReference Include="..\..\demo\PlayBlazor.Demo.Shared\PlayBlazor.Demo.Shared.csproj" />
  </ItemGroup>

</Project>
