@namespace PlayBlazor.Shell.Workspace
@using PlayBlazor.CodeGen
@using PlayBlazor.Model
@using PlayBlazor.Rendering
@using PlayBlazor.Shell
@using PlayBlazor.State

@if (_selected is null)
{
    <div class="pbw-empty">No components discovered in the given assemblies.</div>
    return;
}

<div class="pbw @(_present ? "pbw-present" : null)" data-mtab="@_mobileTab"
     style="--pbw-right:@(_layout.RightWidth.ToString(System.Globalization.CultureInfo.InvariantCulture))px;--pbw-bottom:@(_layout.BottomHeight.ToString(System.Globalization.CultureInfo.InvariantCulture))px">

    <header class="pbw-bar">
        @* "./" resolves against <base href>, so the wordmark lands on the app root wherever the host
           mounts it. A bare "/" would jump to the domain root instead. *@
        <a class="pbw-wordmark" href="./" title="Back to the landing page"><span>&#9654;</span> PlayBlazor</a>
        @* The rail is the browser on wide screens; on narrow ones this grouped picker takes over,
           so categories and counts stay visible without the rail. *@
        <select class="pbw-picker" value="@_selected.DisplayName" @key="_pickerVersion"
                @onchange="OnPickerChanged" aria-label="Component">
            @foreach (var group in PickerGroups)
            {
                <optgroup label="@($"{GroupLabel(group.Key)} · {group.Count()}")">
                    @foreach (var component in group)
                    {
                        <option value="@component.DisplayName" selected="@(component.Type == _selected.Type)">@component.DisplayName</option>
                    }
                </optgroup>
            }
        </select>
        <div class="pbw-pills" role="group" aria-label="Panels">
            @for (var i = 0; i < Panels.Length; i++)
            {
                var panel = Panels[i];
                var shortcut = i + 1;
                <button type="button" @key="panel.Id"
                        class="pbw-pill @(!_layout.IsHidden(panel.Id) ? "pbw-pill-on" : null)"
                        aria-pressed="@(!_layout.IsHidden(panel.Id) ? "true" : "false")"
                        aria-keyshortcuts="@shortcut"
                        title="@($"Show or hide the {panel.Title} panel ({shortcut})")"
                        @onclick="() => TogglePanel(panel.Id)">@panel.Title<kbd class="pbw-kbd">@shortcut</kbd></button>
            }
        </div>
        <div class="pbw-modes" role="group" aria-label="Workspace mode">
            <button type="button" class="pbw-mode @(!_present ? "pbw-mode-active" : null)" aria-pressed="@(!_present ? "true" : "false")" @onclick="() => SetPresent(false)">Play</button>
            <button type="button" class="pbw-mode @(_present ? "pbw-mode-active" : null)" aria-pressed="@(_present ? "true" : "false")" @onclick="() => SetPresent(true)">Present</button>
        </div>
        <div class="pbw-bar-right">
            <button type="button" class="pbw-help-btn" aria-keyshortcuts="?" aria-label="Help and keyboard shortcuts" title="Help and keyboard shortcuts (?)" @onclick="() => _help = !_help"><span class="pbw-btn-label">Help</span> <kbd class="pbw-kbd">?</kbd></button>
            <button type="button" class="pbw-share" title="Copy a link to this exact configuration" aria-label="Share this configuration" @onclick="CopyShareLink">@Icon(IconShare) <span class="pbw-btn-label">Share</span></button>
        </div>
    </header>

    <main class="pbw-work">
        <nav class="pbw-rail" aria-label="Components">
            <div class="pbw-rail-head">
                <span class="pbw-rail-title">Components</span>
                <span class="pbw-rail-count">@PickerGroups.Sum(static g => g.Count())</span>
            </div>
            <input class="pbw-rail-filter" type="search" placeholder="Filter components (Ctrl+K)" aria-label="Filter components"
                   aria-keyshortcuts="Control+K Meta+K" title="Ctrl+K or ⌘K to focus"
                   value="@_railFilter" @oninput="e => _railFilter = (string?)e.Value ?? string.Empty" />
            <div class="pbw-rail-list">
                @{ var railShown = 0; }
                @foreach (var group in PickerGroups)
                {
                    var items = group.Where(c => _railFilter.Length == 0 || c.DisplayName.Contains(_railFilter, StringComparison.OrdinalIgnoreCase)).ToList();
                    if (items.Count == 0)
                    {
                        continue;
                    }
                    railShown += items.Count;
                    @if (PickerGroups.Skip(1).Any())
                    {
                        <h2 class="pbw-rail-group" @key="group.Key">@GroupLabel(group.Key)</h2>
                    }
                    @foreach (var component in items)
                    {
                        var current = component.Type == _selected.Type;
                        <button type="button" @key="component.Type"
                                class="pbw-rail-item @(current ? "pbw-rail-item-on" : null)"
                                aria-current="@(current ? "true" : null)"
                                @onclick="() => SelectComponent(component)">@if (RailPrefix.Length > 0 && component.DisplayName.StartsWith(RailPrefix, StringComparison.Ordinal))
                                {<span class="pbw-rail-prefix">@RailPrefix</span>@component.DisplayName[RailPrefix.Length..]}
                                else
                                {@component.DisplayName}</button>
                    }
                }
                @if (railShown == 0)
                {
                    <p class="pbw-rail-empty">No component matches “@_railFilter”.</p>
                }
            </div>
            <p class="pbw-rail-hint"><kbd class="pbw-kbd">[</kbd> <kbd class="pbw-kbd">]</kbd> previous / next</p>
        </nav>

        <section class="pbw-stage @(_environment.Dark || _present ? "pbw-stage-dark" : null) @(_environment.Checkerboard ? "pbw-stage-checker" : null)" aria-label="Stage">
            @if (!_present)
            {
                <div class="pbw-stage-top">
                    @if (Variants.Count > 0)
                    {
                        <div class="pbw-chips" role="group" aria-label="Examples">
                            <span class="pbw-chips-label">Examples</span>
                            @foreach (var variant in Variants)
                            {
                                <button type="button" @key="variant.Name"
                                        class="pbw-chip @(_activeVariant == variant.Name ? "pbw-chip-active" : null)"
                                        aria-pressed="@(_activeVariant == variant.Name ? "true" : "false")"
                                        @onclick="() => PickVariantManually(variant)">@variant.Name</button>
                            }
                        </div>
                    }
                    <div class="pbw-stage-toolbar" role="group" aria-label="Stage surface">
                        <button type="button" class="pbw-env-btn @(_environment.Dark ? "pbw-env-on" : null)"
                                title="Render the component on a dark surface" aria-pressed="@(_environment.Dark ? "true" : "false")" @onclick="ToggleDark">Dark</button>
                        <button type="button" class="pbw-env-btn @(_environment.Rtl ? "pbw-env-on" : null)"
                                title="Render the component right-to-left" aria-pressed="@(_environment.Rtl ? "true" : "false")" @onclick="ToggleRtl">RTL</button>
                        <button type="button" class="pbw-env-btn @(_environment.Checkerboard ? "pbw-env-on" : null)"
                                title="Checkerboard surface, to reveal transparency" aria-pressed="@(_environment.Checkerboard ? "true" : "false")" @onclick="ToggleChecker">Checker</button>
                        <select class="pbw-env-width" title="Viewport width" aria-label="Viewport width" value="@(_environment.ViewportWidth?.ToString() ?? "")" @onchange="OnViewportChanged">
                            <option value="">Auto width</option>
                            <option value="360">360 px</option>
                            <option value="768">768 px</option>
                            <option value="1200">1200 px</option>
                        </select>
                    </div>
                </div>
            }
            @if (!_selected.CanInstantiate)
            {
                <div class="pbw-error" role="alert">
                    <strong>This component cannot be rendered.</strong>
                    <p class="pbw-error-hint">
                        The playground cannot create it on its own. Pick another component in the list;
                        the reason below tells the host what this one needs.
                    </p>
                    <pre>@_selected.Warning</pre>
                </div>
            }
            else
            {
                <div class="pbw-specimen-zone @(_environment.ViewportWidth is not null ? "pbw-specimen-constrained" : null)"
                     dir="@(_environment.Rtl ? "rtl" : null)"
                     style="@(_environment.ViewportWidth is { } width ? $"width:{width}px" : null)">
                    <div class="pbw-specimen-box">
                        <ErrorBoundary @ref="_errorBoundary">
                            <ChildContent>
                                <CascadingValue Value="_environment">
                                    @if (Options.ThemeWrapper is { } wrapper)
                                    {
                                        @wrapper(new PlaygroundThemeContext(ScaffoldedSpecimen, _environment))
                                    }
                                    else
                                    {
                                        @ScaffoldedSpecimen
                                    }
                                </CascadingValue>
                            </ChildContent>
                            <ErrorContent Context="exception">
                                <div class="pbw-error" role="alert">
                                    <strong>The component threw an exception.</strong>
                                    @if (LooksLikeMissingParent(exception))
                                    {
                                        <p class="pbw-error-hint">
                                            This component most likely requires a specific parent (a grid column needs
                                            its grid, a toggle item its group) and cannot run standalone yet.
                                        </p>
                                    }
                                    <pre>@exception.GetType().Name: @exception.Message</pre>
                                    <details class="pbw-error-stack">
                                        <summary>Stack trace</summary>
                                        <pre>@exception.ToString()</pre>
                                    </details>
                                    <button type="button" class="pbw-error-reset" @onclick="RecoverFromError">@Icon(IconReset) Reset the component</button>
                                </div>
                            </ErrorContent>
                        </ErrorBoundary>
                    </div>
                    @* Shown by playground-workspace.js when the specimen draws nothing measurable. *@
                    <p class="pbw-blank-note">
                        Nothing visible on the stage: @_selected.DisplayName renders no visible output with its current parameters.
                        The Tree panel shows what it rendered.
                    </p>
                </div>
            }
            <div class="pbw-stage-name">&#8249;@_selected.DisplayName /&#8250; &#183; @_selected.Parameters.Count parameters &#183; @(Options.CategoryOf(_selected.Type) ?? ShortCategory(_selected.Category))</div>
        </section>

        @* Narrow screens: the panels become tabs right under the stage, one shown at a time. *@
        <div class="pbw-mtabs" role="tablist" aria-label="Panels">
            @foreach (var panel in Panels)
            {
                var on = _mobileTab == panel.Id;
                <button type="button" role="tab" @key="panel.Id" class="pbw-mtab @(on ? "pbw-mtab-on" : null)"
                        aria-selected="@(on ? "true" : "false")" @onclick="() => ShowMobileTab(panel.Id)">@panel.Title@if (panel.Id == SignalsId && _eventLog.Entries.Count > 0)
                        {<span class="pbw-mtab-count">@_eventLog.Entries.Count</span>}</button>
            }
        </div>

        <div class="pbw-zone pbw-zone-bottom" data-empty="@(ZoneEmpty(WorkspaceLayout.BottomZone) ? "true" : "false")">
            <div class="pbw-zgrip pbw-zgrip-bottom" title="Drag to resize"></div>
            @foreach (var id in _layout.Zone(WorkspaceLayout.BottomZone))
            {
                if (!_layout.IsHidden(id))
                {
                    @PanelFragment(id)
                }
            }
        </div>
        <div class="pbw-zone pbw-zone-right" data-empty="@(ZoneEmpty(WorkspaceLayout.RightZone) ? "true" : "false")">
            <div class="pbw-zgrip pbw-zgrip-right" title="Drag to resize"></div>
            @foreach (var id in _layout.Zone(WorkspaceLayout.RightZone))
            {
                if (!_layout.IsHidden(id))
                {
                    @PanelFragment(id)
                }
            }
        </div>
    </main>

    @foreach (var panel in Panels)
    {
        if (_layout.Float(panel.Id) is not null && !_layout.IsHidden(panel.Id))
        {
            @PanelFragment(panel.Id)
        }
    }

    @if (_present)
    {
        <div class="pbw-hud">
            <span class="pbw-hud-name"><span>&#8249;</span>@_selected.DisplayName<span>/&#8250;</span></span>
            @if (Variants.Count > 0)
            {
                <div class="pbw-film">
                    @foreach (var variant in Variants)
                    {
                        <button type="button" @key="variant.Name"
                                class="pbw-film-chip @(_activeVariant == variant.Name ? "pbw-film-active" : null) @(_autoPlaying ? "pbw-film-auto" : null)"
                                @onclick="() => PickVariantManually(variant)">@variant.Name</button>
                    }
                </div>
                <button type="button" class="pbw-hud-pause" @onclick="ToggleAutoplay"
                        title="@(_autoPlaying ? "Pause" : "Play")">@(_autoPlaying ? "❚❚" : "▶")</button>
            }
            <span class="pbw-hud-exit">esc to exit</span>
        </div>
    }

    @if (_help)
    {
        <div class="pbw-help-scrim" @onclick="() => _help = false"></div>
        <div class="pbw-help" role="dialog" aria-modal="true" aria-labelledby="pbw-help-title">
            <div class="pbw-help-head">
                <h2 id="pbw-help-title">Help and shortcuts</h2>
                <button type="button" class="pbw-help-close" aria-label="Close" @onclick="() => _help = false">@Icon(IconClose)</button>
            </div>
            <dl class="pbw-help-list">
                <dt><kbd class="pbw-kbd">1</kbd>–<kbd class="pbw-kbd">4</kbd></dt><dd>Show or hide Tree, Parameters, Razor, Events</dd>
                <dt><kbd class="pbw-kbd">[</kbd> <kbd class="pbw-kbd">]</kbd></dt><dd>Previous / next component</dd>
                <dt><kbd class="pbw-kbd">↑</kbd> <kbd class="pbw-kbd">↓</kbd></dt><dd>Move through the component list or the tree</dd>
                <dt><kbd class="pbw-kbd">Ctrl</kbd> <kbd class="pbw-kbd">K</kbd></dt><dd>Find a component (<kbd class="pbw-kbd">⌘</kbd> <kbd class="pbw-kbd">K</kbd> on a Mac)</dd>
                <dt><kbd class="pbw-kbd">/</kbd></dt><dd>Filter parameters</dd>
                <dt><kbd class="pbw-kbd">←</kbd> <kbd class="pbw-kbd">→</kbd></dt><dd>Step through examples while presenting</dd>
                <dt><kbd class="pbw-kbd">Esc</kbd></dt><dd>Leave Present, close this sheet</dd>
                <dt><kbd class="pbw-kbd">?</kbd></dt><dd>Show this sheet</dd>
            </dl>
            <h3 class="pbw-help-sub">Reading the bench</h3>
            <dl class="pbw-help-terms">
                <dt>Tree</dt><dd>What the stage renders. A <em>wrapped</em> component sits inside the parent it needs.</dd>
                <dt>Parameters</dt><dd>Every [Parameter] the component declares. A dot marks a changed value; <em>set by the demo</em> means the demo fills it for you; <em>code only</em> means it has no control here.</dd>
                <dt>Events</dt><dd>Every EventCallback the component raises, newest first.</dd>
            </dl>
            <p class="pbw-help-note">
                Drag a panel by its header to dock it elsewhere or float it; double-click the header to send it back.
                <button type="button" class="pbw-help-reset" @onclick="ResetLayout">Reset layout</button>
            </p>
        </div>
    }

    @* Always in the DOM, so screen readers hear each message the moment it lands. *@
    <div class="pbw-toast" role="status" aria-live="polite">@_toast</div>
</div>

@code {
    private RenderFragment Specimen =>
        @<DynamicComponent @key="@_state.InstanceKey"
                           Type="@_selected!.Type"
                           Parameters="@ParameterDictionaryBuilder.Build(_selected!, _state, Options, _eventLog)" />;

    private RenderFragment ScaffoldedSpecimen
        => Options.TryGetScaffold(_selected!.Type, out var scaffold) ? scaffold(Specimen) : Specimen;

    private RenderFragment PanelFragment(string id) => id switch
    {
        GraphId => @<WorkspacePanel @key="GraphId" Id="@GraphId" Title="Tree"
                                    Badge="@(Options.TryGetScaffold(_selected!.Type, out _) ? "wrapped" : null)"
                                    Collapsed="_collapsed.Contains(GraphId)" FloatInfo="_layout.Float(GraphId)"
                                    OnToggleCollapse="() => ToggleCollapse(GraphId)"
                                    OnClose="() => ClosePanel(GraphId)"
                                    OnRedock="() => _layout.Redock(GraphId)">
            <Body>
                @foreach (var node in GraphNodes())
                {
                    switch (node.Kind)
                    {
                        case GraphNodeKind.Scaffold:
                            <span class="pbw-tnode pbw-tnode-info" style="padding-left:@(0.45 + node.Depth * 0.85)rem"
                                  title="The demo renders the component inside this wrapper, because it needs a parent">
                                <span class="pbw-tag-p">&#9671;</span> @node.Label
                            </span>
                            break;
                        case GraphNodeKind.Component:
                            <span class="pbw-tnode @(node.Selected ? "pbw-tnode-sel" : null)"
                                  style="padding-left:@(0.45 + node.Depth * 0.85)rem">
                                <span class="pbw-tag-p">&lt;</span><span class="pbw-tag-n">@node.Label</span>@if (node.Attrs is not null)
                                {<span class="pbw-tag-a">@($" {node.Attrs}")</span>}<span class="pbw-tag-p">&gt;</span>
                            </span>
                            break;
                        case GraphNodeKind.Slot:
                            <span class="pbw-tnode pbw-tnode-slot" style="padding-left:@(0.45 + node.Depth * 0.85)rem"
                                  title="@(node.Attrs is null ? "Filled by you" : "Filled by the host")">
                                <span class="pbw-tag-p">&lt;</span><span class="pbw-tag-n">@node.Label</span><span class="pbw-tag-p">&gt;</span>
                                @if (node.Attrs is not null)
                                {
                                    <span class="pbw-tnode-note">&#9671; @node.Attrs</span>
                                }
                            </span>
                            break;
                    }
                }
                @if (RelatedComponents() is { Count: > 0 } related)
                {
                    <span class="pbw-tree-eyebrow">Related</span>
                    @foreach (var component in related)
                    {
                        <button type="button" @key="component.Type"
                                class="pbw-tnode pbw-tnode-link" title="Open this component"
                                @onclick="() => SelectComponent(component)">
                            <span class="pbw-tnode-arrow">&#8599;</span>
                            <span class="pbw-tag-p">&lt;</span><span class="pbw-tag-n">@component.DisplayName</span>@if (GenericAttrs(component.Type) is { } attrs)
                            {<span class="pbw-tag-a">@($" {attrs}")</span>}<span class="pbw-tag-p">&gt;</span>
                        </button>
                    }
                }
            </Body>
        </WorkspacePanel>,
        ParametersId => @<WorkspacePanel @key="ParametersId" Id="@ParametersId" Title="Parameters"
                                         Collapsed="_collapsed.Contains(ParametersId)" FloatInfo="_layout.Float(ParametersId)"
                                         OnToggleCollapse="() => ToggleCollapse(ParametersId)"
                                         OnClose="() => ClosePanel(ParametersId)"
                                         OnRedock="() => _layout.Redock(ParametersId)">
            <Actions>
                <button type="button" class="pbw-foldall pbw-ph-labeled" title="@(_allFolded ? "Unfold every group" : "Fold every group")"
                        @onclick="ToggleFoldAll">@Icon(_allFolded ? IconUnfold : IconFold) @(_allFolded ? "Unfold all" : "Fold all")</button>
                <button type="button" class="pbw-preset-node pbw-ph-labeled" title="Reset every parameter to its default" @onclick="ResetNode">@Icon(IconReset) Reset all</button>
            </Actions>
            <Body>
                <div class="pbw-ptoolbar">
                    <input class="pbw-pfilter" type="search" placeholder="Filter parameters (/)" title="Press / to focus" aria-label="Filter parameters" aria-keyshortcuts="/"
                           value="@_paramFilter" @oninput="e => _paramFilter = (string?)e.Value ?? string.Empty" />
                    <button type="button" class="pbw-modchip @(_modifiedOnly ? "pbw-modchip-on" : null)"
                            title="Show only modified parameters"
                            @onclick="() => _modifiedOnly = !_modifiedOnly">Modified &#183; @ModifiedCount/@_selected!.Parameters.Count</button>
                </div>
                @if (ParameterGroups.All(g => VisibleRows(g).Count == 0))
                {
                    <p class="pbw-params-empty">
                        No parameter matches this filter@(_modifiedOnly ? " — nothing is modified yet" : null).
                    </p>
                }
                @foreach (var group in ParameterGroups)
                {
                    var rows = VisibleRows(group);
                    if (rows.Count == 0)
                    {
                        continue;
                    }
                    <details class="pbw-pgroup" @key="group.Key" open="@IsGroupOpen(group.Key)">
                        <summary @onclick="() => ToggleGroup(group.Key)" @onclick:preventDefault>@group.Key</summary>
                        @foreach (var parameter in rows)
                        {
                            <div class="pbw-prow @(_state.IsModified(parameter.Name) ? "pbw-prow-modified" : null)"
                                 @key="parameter.Name" title="@ParameterSignature.Format(parameter)">
                                @if (IsDrivable(parameter) && IsDemoFilled(parameter) && !_overrides.Contains(parameter.Name) && !_state.IsModified(parameter.Name))
                                {
                                    @* An empty box would misstate what the stage shows: the demo fills this slot. *@
                                    <span class="pbw-prow-name">@parameter.Name</span>
                                    <span class="pbw-demo-filled">
                                        <span class="pbw-slot-badge" title="The demo fills this in for you; it shows in the Tree and Razor panels">set by the demo</span>
                                        <button type="button" class="pbw-override" aria-label="@($"Override {parameter.Name} with your own text")"
                                                @onclick="() => _overrides.Add(parameter.Name)">Override</button>
                                    </span>
                                }
                                else if (IsDrivable(parameter))
                                {
                                    <ControlHost Parameter="parameter"
                                                 Value="EffectiveValue(parameter)"
                                                 ValueChanged="value => OnControlChanged(parameter, value)" />
                                    @if (_state.IsModified(parameter.Name) || _overrides.Contains(parameter.Name))
                                    {
                                        <button type="button" class="pbw-prow-reset"
                                                title="@(IsDemoFilled(parameter) ? "Back to the demo's content" : "Restore default")"
                                                aria-label="@($"Restore the default {parameter.Name}")"
                                                @onclick="() => RestoreParameter(parameter.Name)">@Icon(IconReset)</button>
                                    }
                                }
                                else if (parameter.Kind is ControlKind.Event)
                                {
                                    <span class="pbw-prow-name">@parameter.Name</span>
                                    <span class="pbw-wired" title="Every time the component raises it, it shows in the Events panel">logged in Events</span>
                                }
                                else
                                {
                                    <span class="pbw-prow-name">@parameter.Name</span>
                                    @if (Options.TryGetSlotPreset(_selected!.Type, parameter.Name, out _) || Options.TryGetTemplatePreset(_selected!.Type, parameter.Name, out _) || Options.TryGetParameterPreset(_selected!.Type, parameter.Name, out _))
                                    {
                                        <span class="pbw-slot-badge" title="The demo fills this in for you; it shows in the Tree and Razor panels">set by the demo</span>
                                    }
                                    else
                                    {
                                        <span class="pbw-slot-badge" title="@($"Set it from code: {ParameterSignature.TypeName(parameter.Type)}")">@ParameterSignature.FriendlyTypeName(parameter.Type) · code only</span>
                                    }
                                }
                                @if (parameter.Summary is { Length: > 0 } summary)
                                {
                                    <p class="pbw-prow-doc">@summary</p>
                                }
                            </div>
                        }
                    </details>
                }
            </Body>
        </WorkspacePanel>,
        RazorId => @<WorkspacePanel @key="RazorId" Id="@RazorId" Title="Razor" Badge="generated"
                                    Collapsed="_collapsed.Contains(RazorId)" FloatInfo="_layout.Float(RazorId)"
                                    OnToggleCollapse="() => ToggleCollapse(RazorId)"
                                    OnClose="() => ClosePanel(RazorId)"
                                    OnRedock="() => _layout.Redock(RazorId)">
            <Actions>
                <button type="button" class="pbw-ph-copy pbw-ph-labeled" title="Copy the Razor markup to the clipboard" @onclick="CopyRazor">@Icon(IconCopy) Copy</button>
            </Actions>
            <Body>
                <pre class="pbw-code"><code>@SnippetMarkup</code></pre>
            </Body>
        </WorkspacePanel>,
        SignalsId => @<WorkspacePanel @key="SignalsId" Id="@SignalsId" Title="Events" Badge="@_eventLog.Entries.Count.ToString()"
                                      Collapsed="_collapsed.Contains(SignalsId)" FloatInfo="_layout.Float(SignalsId)"
                                      OnToggleCollapse="() => ToggleCollapse(SignalsId)"
                                      OnClose="() => ClosePanel(SignalsId)"
                                      OnRedock="() => _layout.Redock(SignalsId)">
            <Actions>
                <button type="button" class="pbw-ph-clear pbw-ph-labeled" title="Clear the event log" @onclick="() => _eventLog.Clear()">@Icon(IconClear) Clear</button>
            </Actions>
            <Body>
                @if (_eventLog.Entries.Count == 0)
                {
                    @if (EventParameters.Any())
                    {
                        <p class="pbw-signals-empty">
                            Interact with the component: every EventCallback it raises is logged here.
                            @EventsSummary.
                        </p>
                    }
                    else
                    {
                        <p class="pbw-signals-empty">This component exposes no events.</p>
                    }
                }
                else
                {
                    <ul class="pbw-signal-list">
                        @foreach (var entry in _eventLog.Entries)
                        {
                            <li>
                                <button type="button" class="pbw-signal @(entry.Detail is null ? "pbw-signal-flat" : null)"
                                        @onclick="() => ToggleUnfold(entry)">
                                    @if (entry.Detail is not null)
                                    {
                                        <span class="pbw-signal-caret">@(_unfolded.Contains(entry) ? "▾" : "▸")</span>
                                    }
                                    <span class="pbw-signal-time">@entry.Timestamp.ToString("HH:mm:ss")</span>
                                    <span class="pbw-signal-name">@entry.Name</span>
                                    <span class="pbw-signal-payload">@entry.Payload</span>
                                </button>
                                @if (entry.Detail is not null && _unfolded.Contains(entry))
                                {
                                    <pre class="pbw-signal-detail">@entry.Detail</pre>
                                }
                            </li>
                        }
                    </ul>
                }
            </Body>
        </WorkspacePanel>,
        _ => @<text></text>,
    };
}
