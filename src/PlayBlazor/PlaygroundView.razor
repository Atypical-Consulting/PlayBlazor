@namespace PlayBlazor
@using PlayBlazor.CodeGen
@using PlayBlazor.Rendering
@using PlayBlazor.Shell

<div class="pb-playground">
    <div class="pb-preview @(_environment.Dark ? "pb-stage-dark" : null) @(_environment.Checkerboard ? "pb-stage-checker" : null)">
        <span class="pb-stage-chip">&lt;@_descriptor.DisplayName /&gt;</span>
        <div class="pb-stage-toolbar">
            <button type="button" class="pb-env-btn pb-env-dark @(_environment.Dark ? "pb-env-on" : null)"
                    title="Dark surface" @onclick="() => _environment.Dark = !_environment.Dark">&#9681;</button>
            <button type="button" class="pb-env-btn pb-env-rtl @(_environment.Rtl ? "pb-env-on" : null)"
                    title="Right-to-left" @onclick="() => _environment.Rtl = !_environment.Rtl">&#8646;</button>
            <button type="button" class="pb-env-btn pb-env-checker @(_environment.Checkerboard ? "pb-env-on" : null)"
                    title="Checkerboard surface" @onclick="() => _environment.Checkerboard = !_environment.Checkerboard">&#9638;</button>
            <select class="pb-env-width" title="Viewport width" value="@(_environment.ViewportWidth?.ToString() ?? "")" @onchange="OnViewportChanged">
                <option value="">Auto</option>
                <option value="360">360</option>
                <option value="768">768</option>
                <option value="1200">1200</option>
            </select>
        </div>
        @if (!_descriptor.CanInstantiate)
        {
            <div class="pb-error">
                <strong>This component cannot be rendered.</strong>
                <pre>@_descriptor.Warning</pre>
            </div>
        }
        else
        {
            <div class="pb-specimen @(_environment.ViewportWidth is not null ? "pb-specimen-constrained" : null)"
                 dir="@(_environment.Rtl ? "rtl" : null)"
                 style="@(_environment.ViewportWidth is { } width ? $"width:{width}px" : null)">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        <CascadingValue Value="_environment">
                            @if (Options.ThemeWrapper is { } wrapper)
                            {
                                @wrapper(new PlaygroundThemeContext(ScaffoldedSpecimen, _environment))
                            }
                            else
                            {
                                @ScaffoldedSpecimen
                            }
                        </CascadingValue>
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <div class="pb-error">
                            <strong>The component threw an exception.</strong>
                            @if (LooksLikeMissingParent(exception))
                            {
                                <p class="pb-error-hint">
                                    This component most likely requires a specific parent (a grid column needs
                                    its grid, a toggle item its group) and cannot run standalone yet.
                                </p>
                            }
                            <pre>@exception.GetType().Name: @exception.Message</pre>
                            <details class="pb-error-stack">
                                <summary>Stack trace</summary>
                                <pre>@exception.ToString()</pre>
                            </details>
                            <button type="button" @onclick="RecoverFromError">Reset</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        }
    </div>
    <div class="pb-panel">
        <div class="pb-panel-header">
            <span class="pb-title" title="@_descriptor.Summary">@_descriptor.DisplayName</span>
            @if (_descriptor.Warning is not null)
            {
                <span class="pb-warning" title="@_descriptor.Warning">&#9888;</span>
            }
            <button type="button" class="pb-share" title="Copy a link to this exact configuration" @onclick="CopyShareLink">Share</button>
            @if (_state.ModifiedValues.Count > 0)
            {
                <button type="button" class="pb-reset" @onclick="ResetAll">Reset all</button>
            }
        </div>
        @if (VariantDefinitions.Count > 0)
        {
            <span class="pb-eyebrow">Examples</span>
            <div class="pb-variants">
                @foreach (var variant in VariantDefinitions)
                {
                    <button type="button" @key="variant.Name"
                            class="pb-variant @(_activeVariant == variant.Name ? "pb-variant-active" : null)"
                            @onclick="() => ApplyVariant(variant)">@variant.Name</button>
                }
            </div>
        }
        <span class="pb-eyebrow">Parameters</span>
        @foreach (var parameter in Controllable)
        {
            <div class="pb-row @(_state.IsModified(parameter.Name) ? "pb-row-modified" : null)" @key="parameter.Name">
                <ControlHost Parameter="parameter"
                             Value="EffectiveValue(parameter)"
                             ValueChanged="value => OnControlChanged(parameter, value)" />
                @if (_state.IsModified(parameter.Name))
                {
                    <button type="button" class="pb-row-reset" title="Restore default"
                            @onclick="() => _state.Reset(parameter.Name)">&times;</button>
                }
            </div>
        }
        @if (Uncontrollable.Any())
        {
            <details class="pb-uncontrolled">
                <summary>Not controlled here (@Uncontrollable.Count())</summary>
                <ul>
                    @foreach (var parameter in Uncontrollable)
                    {
                        <li @key="parameter.Name" title="@parameter.Summary">
                            <span>@parameter.Name</span>
                            <span class="pb-kind">@parameter.Kind</span>
                        </li>
                    }
                </ul>
            </details>
        }
    </div>
    <div class="pb-code">
        <pre><code>@SnippetMarkup</code></pre>
        <button type="button" class="pb-copy" title="Copy to clipboard" @onclick="CopySnippet">Copy</button>
    </div>
    @if (Events.Any())
    {
        <div class="pb-events">
            <span class="pb-eyebrow">Events</span>
            @if (_eventLog.Entries.Count == 0)
            {
                <div class="pb-events-empty">
                    Listening to @string.Join(", ", Events.Select(e => e.Name)) — interactions will show up here.
                </div>
            }
            else
            {
                <button type="button" class="pb-events-clear" @onclick="() => _eventLog.Clear()">Clear</button>
                <ul>
                    @foreach (var entry in _eventLog.Entries)
                    {
                        <li>
                            <span class="pb-event-time">@entry.Timestamp.ToString("HH:mm:ss")</span>
                            <span class="pb-event-name">@entry.Name</span>
                            <span class="pb-event-payload">@entry.Payload</span>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private RenderFragment Specimen =>
        @<DynamicComponent @key="@_state.InstanceKey"
                           Type="@_descriptor.Type"
                           Parameters="@ParameterDictionaryBuilder.Build(_descriptor, _state, Options, _eventLog)" />;

    private RenderFragment ScaffoldedSpecimen
        => Options.TryGetScaffold(_descriptor.Type, out var scaffold) ? scaffold(Specimen) : Specimen;
}
